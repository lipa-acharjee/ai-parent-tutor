# ============================================================
# AI Parent Tutor - Environment Variables
# ============================================================

# ============================================================
# Application
# ============================================================

APP_NAME=AI Parent Tutor
ENVIRONMENT=development
DEBUG=false

SECRET_KEY=replace_with_a_long_random_secret

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ============================================================
# Database
# ============================================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/parent_tutor

# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://redis:6379/0

# ============================================================
# AI / LLM
# ============================================================

GROQ_API_KEY=replace_with_your_groq_api_key

LLM_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# Object Storage
# Local development currently uses MinIO.
# Production will use cloud S3-compatible storage.
# ============================================================

S3_ENDPOINT_URL=http://minio:9000

S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

S3_BUCKET=parent-tutor

S3_ACCESS_KEY=replace_with_storage_access_key

S3_SECRET_KEY=replace_with_storage_secret_key

AWS_REGION=ap-south-1

# ============================================================
# Uploads
# ============================================================

MAX_UPLOAD_MB=50

# ============================================================
# CORS
# ============================================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# Observability
# ============================================================

OTEL_ENABLED=true

PROMETHEUS_ENABLED=true

# ============================================================
# Video
# ============================================================

VIDEO_PROVIDER=local

VIDEO_STORAGE=minio

VIDEO_MAX_DURATION_SECONDS=600

VIDEO_DEFAULT_VOICE=en-US-JennyNeural

VIDEO_WIDTH=1280

VIDEO_HEIGHT=720

VIDEO_FPS=30

# ============================================================
# Google OAuth
# ============================================================

GOOGLE_CLIENT_ID=replace_with_google_client_id

GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback