{
  "family": "ai-parent-tutor-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [{
    "name": "api",
    "image": "ACCOUNT.dkr.ecr.REGION.amazonaws.com/ai-parent-tutor-api:latest",
    "essential": true,
    "portMappings": [{"containerPort": 8000,"protocol":"tcp"}],
    "command": ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000"],
    "healthCheck": {"command":["CMD-SHELL","python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\" || exit 1"],"interval":30,"timeout":5,"retries":3,"startPeriod":30}
  }]
}
